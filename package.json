{
  "name": "elpriser-org",
  "version": "1.0.0",
  "private": true,
  "description": "Danish electricity price tracker \u2014 elpriser.org",
  "scripts": {
    "start": "node server.js",
    "test": "node test.js",
    "test:static": "node test-static.js",
    "test:e2e": "node test-e2e.js",
    "test:regressions": "node test-regressions.js",
    "test:pre-commit": "node test-static.js && node test-e2e.js && node test-regressions.js",
    "deploy": "bash scripts/build-dist.sh && npx wrangler pages deploy dist --project-name=elpriser-org",
    "build": "bash scripts/build-dist.sh",
    "test:urls": "node test-urls.js"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
