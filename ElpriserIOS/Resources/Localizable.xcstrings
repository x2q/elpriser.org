    "welcome_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din elregning afhænger af, hvem der ejer ledningerne til dit hus. Med din position finder vi netselskabet, så priserne i appen er dem, du faktisk betaler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your electricity bill depends on who owns the wires to your home. With your position we find your grid company, so the prices in the app are the ones you actually pay."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je energierekening hangt af van wie de leidingen naar je huis beheert. Met je locatie vinden we de netbeheerder, zodat de prijzen in de app de prijzen zijn die je echt betaalt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din elräkning beror på vem som äger ledningarna till ditt hus. Med din position hittar vi nätbolaget, så att priserna i appen är de du faktiskt betalar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømregningen din avhenger av hvem som eier ledningene til huset ditt. Med posisjonen din finner vi nettselskapet, slik at prisene i appen er dem du faktisk betaler."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømregningen din avhenger av hvem som eier ledningene til huset ditt. Med posisjonen din finner vi nettselskapet, slik at prisene i appen er dem du faktisk betaler."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømregningen din avhenger av hvem som eier ledningene til huset ditt. Med posisjonen din finner vi nettselskapet, slik at prisene i appen er dem du faktisk betaler."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sähkölaskusi riippuu siitä, kuka omistaa taloosi johtavat linjat. Sijaintisi avulla löydämme verkkoyhtiön, jotta sovelluksen hinnat ovat niitä, jotka todella maksat."
          }
        }
      }
