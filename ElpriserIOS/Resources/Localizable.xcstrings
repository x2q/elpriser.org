    "welcome_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din elregning afhænger af, hvem der ejer ledningerne til dit hus. Med din position finder vi netselskabet, så priserne i appen er dem, du faktisk betaler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your electricity bill depends on who owns the wires to your home. With your position we find your grid company, so the prices in the app are the ones you actually pay."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stromrechnung hängt davon ab, wem die Leitungen zum Haus gehören. Anhand des Standorts wird der Netzbetreiber ermittelt, damit die Preise in der App die sind, die tatsächlich gezahlt werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre facture d'électricité dépend de qui exploite les lignes jusqu'à votre logement. Grâce à votre position, nous trouvons le gestionnaire de réseau, afin que les prix de l'app soient ceux que vous payez réellement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je energierekening hangt af van wie de leidingen naar je huis beheert. Met je locatie vinden we de netbeheerder, zodat de prijzen in de app de prijzen zijn die je echt betaalt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bolletta della luce dipende da chi gestisce le linee fino a casa. Con la posizione si individua il gestore di rete, così i prezzi nell'app sono quelli effettivamente pagati."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rachunek za prąd zależy od tego, kto zarządza liniami doprowadzającymi prąd do domu. Dzięki lokalizacji znajdziemy operatora sieci, aby ceny w aplikacji odpowiadały tym, które naprawdę płacisz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din elräkning beror på vem som äger ledningarna till ditt hus. Med din position hittar vi nätbolaget, så att priserna i appen är de du faktiskt betalar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømregningen din avhenger av hvem som eier ledningene til huset ditt. Med posisjonen din finner vi nettselskapet, slik at prisene i appen er dem du faktisk betaler."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømregningen din avhenger av hvem som eier ledningene til huset ditt. Med posisjonen din finner vi nettselskapet, slik at prisene i appen er dem du faktisk betaler."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømregningen din avhenger av hvem som eier ledningene til huset ditt. Med posisjonen din finner vi nettselskapet, slik at prisene i appen er dem du faktisk betaler."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sähkölaskusi riippuu siitä, kuka omistaa taloosi johtavat linjat. Sijaintisi avulla löydämme verkkoyhtiön, jotta sovelluksen hinnat ovat niitä, jotka todella maksat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše faktura za elektřinu závisí na tom, komu patří vedení k vašemu domu. Podle vaší polohy najdeme distributora, takže ceny v aplikaci budou ty, které skutečně platíte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az áramszámla attól függ, ki üzemelteti a házához vezető hálózatot. A tartózkodási helye alapján megkeressük a hálózatüzemeltetőt, így az alkalmazásban azokat az árakat látja, amelyeket valóban fizet."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš račun za elektriko je odvisen od tega, kdo upravlja omrežje do vašega doma. Z vašo lokacijo poiščemo operaterja omrežja, tako da so cene v aplikaciji tiste, ki jih dejansko plačate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu factura de la luz depende de quién es el propietario de las líneas que llegan a tu casa. Con tu ubicación encontramos la distribuidora, para que los precios de la app sean los que realmente pagas."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua fatura da eletricidade depende de quem é o dono das linhas que chegam à sua casa. Com a sua localização encontramos o operador de rede, para que os preços da app sejam os que realmente paga."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša faktúra za elektrinu závisí od toho, komu patria vedenia k vášmu domu. Podľa vašej polohy nájdeme distribútora, takže ceny v aplikácii budú tie, ktoré skutočne platíte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο λογαριασμός ρεύματός σας εξαρτάται από το ποιος κατέχει το δίκτυο που φτάνει στο σπίτι σας. Με την τοποθεσία σας βρίσκουμε τον διαχειριστή δικτύου, ώστε οι τιμές στην εφαρμογή να είναι αυτές που πραγματικά πληρώνετε."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Factura ta de electricitate depinde de cine deține rețeaua care ajunge la casa ta. Cu ajutorul locației tale găsim operatorul de distribuție, astfel încât prețurile din aplicație să fie cele pe care le plătești cu adevărat."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сметката ви за ток зависи от това кой притежава мрежата до дома ви. С помощта на местоположението ви намираме мрежовия оператор, така че цените в приложението да са тези, които наистина плащате."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš račun za struju ovisi o tome tko upravlja mrežom do vašeg doma. Pomoću vaše lokacije pronalazimo operatora mreže pa su cijene u aplikaciji one koje stvarno plaćate."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш рачун за струју зависи од тога ко управља мрежом до вашег дома. Помоћу ваше локације проналазимо оператора мреже, па су цене у апликацији оне које заиста плаћате."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš račun za struju zavisi od toga ko upravlja mrežom do vašeg doma. Pomoću vaše lokacije pronalazimo operatora mreže, pa su cene u aplikaciji one koje zaista plaćate."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu elektriarve sõltub sellest, kellele kuuluvad sinu koduni viivad liinid. Asukoha järgi leiame võrguettevõtte, et rakenduse hinnad oleksid need, mida sa tegelikult maksad."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu elektrības rēķins ir atkarīgs no tā, kam pieder vadi līdz jūsu mājai. Pēc atrašanās vietas mēs atrodam tīkla operatoru, lai cenas lietotnē būtu tās, ko jūs patiešām maksājat."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų sąskaita už elektrą priklauso nuo to, kam priklauso laidai iki jūsų namų. Pagal buvimo vietą randame tinklo operatorių, kad kainos programėlėje būtų tos, kurias iš tikrųjų mokate."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашата сметка за струја зависи од тоа кој ја поседува мрежата до вашиот дом. Со помош на вашата локација го наоѓаме мрежниот оператор, па цените во апликацијата се оние што навистина ги плаќате."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatura juaj e rrymës varet nga ai që zotëron linjat deri në shtëpinë tuaj. Me vendndodhjen tuaj gjejmë operatorin e rrjetit, që çmimet në aplikacion të jenë ato që paguani realisht."
          }
        }
      }
    },
