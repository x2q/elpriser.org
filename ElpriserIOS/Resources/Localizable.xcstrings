    "place_net_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med et netselskab inkluderer prisen nettarif, afgifter og moms som på din regning."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With a grid company the price includes grid tariff, taxes and VAT as on your bill."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Netzbetreiber enthält der Preis Netzentgelt, Abgaben und MwSt. wie auf der Rechnung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec un gestionnaire de réseau, le prix inclut le tarif réseau, les taxes et la TVA, comme sur votre facture."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een netbeheerder bevat de prijs nettarief, belastingen en btw, zoals op je rekening."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un gestore di rete il prezzo include tariffa di rete, imposte e IVA, come in bolletta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z operatorem sieci cena zawiera opłatę dystrybucyjną, podatki i VAT, tak jak na rachunku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med ett nätbolag ingår nättariff, skatter och moms i priset, som på din räkning."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med et nettselskap inkluderer prisen nettleie, avgifter og mva. som på regningen din."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
