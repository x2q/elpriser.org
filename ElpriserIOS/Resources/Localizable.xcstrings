    "note_denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positionen blev ikke delt. Vælg dit netselskab på listen — så virker appen på samme måde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your position was not shared. Choose your grid company from the list — the app works the same way."
