    "welcome_zone_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elprisen afhænger af dit prisområde. Vælg dit land, så viser appen børsprisen time for time."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The electricity price depends on your price zone. Choose your country and the app shows the spot price hour by hour."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Strompreis hängt von der Preiszone ab. Land wählen, dann zeigt die App den Börsenpreis Stunde für Stunde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prix de l'électricité dépend de votre zone de prix. Choisissez votre pays et l'app affiche le prix de bourse heure par heure."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De stroomprijs hangt af van je biedzone. Kies je land, dan toont de app de spotprijs per uur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prezzo dell'elettricità dipende dalla zona di prezzo. Scegliere il paese: l'app mostra il prezzo di borsa ora per ora."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena prądu zależy od strefy cenowej. Wybierz kraj, a aplikacja pokaże cenę giełdową godzina po godzinie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elpriset beror på ditt elområde. Välj ditt land, så visar appen spotpriset timme för timme."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømprisen avhenger av prisområdet ditt. Velg landet ditt, så viser appen spotprisen time for time."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømprisen avhenger av prisområdet ditt. Velg landet ditt, så viser appen spotprisen time for time."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømprisen avhenger av prisområdet ditt. Velg landet ditt, så viser appen spotprisen time for time."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sähkön hinta riippuu hinta-alueestasi. Valitse maasi, niin sovellus näyttää pörssihinnan tunti tunnilta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena elektřiny závisí na vaší cenové zóně. Vyberte svou zemi a aplikace zobrazí spotovou cenu hodinu po hodině."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az áram ára az ajánlati zónától függ. Válassza ki az országát, és az alkalmazás óránként megmutatja a tőzsdei árat."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena elektrike je odvisna od vašega cenovnega območja. Izberite državo in aplikacija bo prikazala borzno ceno po urah."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El precio de la luz depende de tu zona de precios. Elige tu país y la app mostrará el precio spot hora a hora."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O preço da eletricidade depende da sua zona de preços. Escolha o seu país e a app mostra o preço spot hora a hora."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena elektriny závisí od vašej cenovej zóny. Vyberte svoju krajinu a aplikácia zobrazí spotovú cenu hodinu po hodine."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τιμή του ρεύματος εξαρτάται από τη ζώνη τιμών σας. Επιλέξτε τη χώρα σας και η εφαρμογή εμφανίζει την τιμή spot ώρα προς ώρα."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prețul energiei electrice depinde de zona ta de preț. Alege țara, iar aplicația arată prețul spot oră cu oră."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цената на тока зависи от вашата ценова зона. Изберете държава и приложението показва спот цената час по час."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cijena struje ovisi o vašoj cjenovnoj zoni. Odaberite zemlju i aplikacija će prikazati burzovnu cijenu sat po sat."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цена струје зависи од ваше ценовне зоне. Изаберите земљу и апликација ће приказати берзанску цену сат по сат."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena struje zavisi od vaše cenovne zone. Izaberite zemlju i aplikacija će prikazati berzansku cenu sat po sat."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elektrihind sõltub sinu hinnapiirkonnast. Vali oma riik ja rakendus näitab börsihinda tunni kaupa."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elektrības cena ir atkarīga no jūsu cenu zonas. Izvēlieties valsti, un lietotne rādīs biržas cenu stundu pa stundai."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elektros kaina priklauso nuo jūsų kainų zonos. Pasirinkite šalį, o programėlė rodys biržos kainą valanda po valandos."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цената на струјата зависи од вашата ценовна зона. Изберете држава и апликацијата ја прикажува спот цената час по час."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çmimi i rrymës varet nga zona juaj e çmimit. Zgjidhni vendin tuaj dhe aplikacioni shfaq çmimin e bursës orë pas ore."
          }
        }
      }
    },
