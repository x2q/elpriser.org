    "about_text" : {
      "comment" : "%1$s is the app version. 'Energi Data Service' (Danish open data), 'ENTSO-E' and 'Hugging Face' are proper names.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priser fra Energi Data Service og ENTSO-E · prognosen kommer fra en åben model på Hugging Face · elpriser %1$@"
          }
        },
        "en" : {
